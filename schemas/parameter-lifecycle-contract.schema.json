{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football.model-parameter-lifecycle-contract.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "baseline_source_version",
    "release_version",
    "delivery_phase",
    "integration_point_h_required",
    "required_h_contract_key",
    "formal_partition",
    "formal_horizons",
    "candidate_generation",
    "shadow_validation",
    "promotion",
    "provider_state",
    "candidate_statuses",
    "commands",
    "migration",
    "artifacts",
    "compatibility"
  ],
  "properties": {
    "contract_id": { "const": "football.model-parameter-lifecycle.v1" },
    "contract_version": { "const": "1.0.0" },
    "baseline_source_version": { "type": "string" },
    "release_version": { "type": "string" },
    "delivery_phase": { "type": "string" },
    "integration_point_h_required": { "const": true },
    "required_h_contract_key": { "const": "p4-postmatch-settlement" },
    "formal_partition": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
    "formal_horizons": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "candidate_generation": { "type": "object" },
    "shadow_validation": { "type": "object" },
    "promotion": { "type": "object" },
    "provider_state": { "const": "NOT_BUNDLED" },
    "candidate_statuses": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string" } },
    "commands": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "migration": { "const": "crates/persistence-postgres/migrations/0025_parameter_lifecycle.sql" },
    "artifacts": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "compatibility": { "type": "object" }
  }
}
