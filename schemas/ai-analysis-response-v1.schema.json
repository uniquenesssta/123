{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football.ai-analysis-response.v1/suggestions.schema.json",
  "title": "足球赛事模型平台 AI 分析建议",
  "description": "AI 分析回包中 suggestions.json 的稳定数据契约。所有建议导入后仍需人工审核。",
  "type": "array",
  "maxItems": 10000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["suggestion_type", "title", "summary"],
    "properties": {
      "suggestion_type": {
        "type": "string",
        "enum": [
          "ability_update",
          "model_parameter",
          "data_quality",
          "database_index",
          "review_finding"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "severity": {
        "type": "string",
        "enum": ["info", "warning", "critical"],
        "default": "info"
      },
      "scope": {
        "type": "object",
        "default": {}
      },
      "payload": {
        "type": "object",
        "default": {}
      },
      "evidence": {
        "type": "object",
        "default": {}
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "suggestion_type": { "const": "ability_update" }
          },
          "required": ["suggestion_type"]
        },
        "then": {
          "properties": {
            "payload": {
              "type": "object",
              "required": ["player_id", "dimension_code", "proposed_value"],
              "properties": {
                "player_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "dimension_code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "proposed_value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sample_size": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    ]
  }
}
